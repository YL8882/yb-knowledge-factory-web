{
  "manifest_version": 3,
  "name": "YB Learn",
  "version": "0.1.0",
  "description": "YB Knowledge Lite — one-click capture of the current YouTube video.",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
